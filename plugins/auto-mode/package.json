{
  "name": "@derogab/pi-auto-mode",
  "version": "0.2.1",
  "description": "Checks Bash commands before execution",
  "type": "module",
  "files": [
    "extensions",
    "auto-mode.example.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test test/*.test.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/derogab/agent-kit.git",
    "directory": "plugins/auto-mode"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/auto-mode.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.0",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@huggingface/hub": "2.13.3"
  }
}
