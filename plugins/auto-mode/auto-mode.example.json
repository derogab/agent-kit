{
  "allow": [
    "^git status$",
    "^git diff$",
    "^npm test$",
    "^npm run (lint|build)$"
  ],
  "ask": [
    "^git commit\\b.*$",
    "^git push\\b.*$",
    "^npm publish\\b.*$"
  ],
  "deny": [
    "^git push\\b.*(-f|--force).*$",
    "^(sudo|doas)\\b.*$",
    "^rm\\b.*-(rf|fr).*$"
  ]
}
